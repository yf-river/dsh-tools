{
  "name": "@yf-river/dsh-restart-button",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Adds a restart page under Settings > Plugins: it asks the Host to exit so a supervisor relaunches it, then reloads the page when the service returns.",
  "keywords": [
    "dsh-plugin",
    "restart",
    "operations",
    "settings",
    "supervisor"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yf-river/dsh-tools.git",
    "directory": "plugins/dsh-restart-button"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
