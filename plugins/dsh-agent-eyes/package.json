{
  "name": "@local/dsh-agent-eyes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lets the agent see the live page: captured failures, a painted-DOM snapshot attributed by owning plugin, the interaction event log, and a read-only probe.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-cordis-client-runner"]
    }
  }
}
