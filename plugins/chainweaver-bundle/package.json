{
  "name": "chainweaver-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "ChainWeaver 产品组合：Web、Superagent 与产品界面配置",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "profiles/chainweaver.json",
    "packages/superagent/cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./packages/superagent/cordis.patch.yml",
        "./cordis.patch.yml"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "scripts": {
    "setup": "node scripts/dev.mjs setup",
    "start": "node scripts/dev.mjs start",
    "dump": "node scripts/dev.mjs dump",
    "check": "node scripts/check-profile.mjs",
    "serve": "node scripts/server.mjs",
    "build": "pnpm --filter dsh-superagent build",
    "test": "node --test packages/platform/tests/*.test.mjs",
    "platform": "node scripts/platform.mjs"
  },
  "dependencies": {
    "dsh-superagent": "file:./packages/superagent",
    "@chainweaver/platform": "file:./packages/platform",
    "chainweaver-runtime": "file:./packages/runtime"
  },
  "packageManager": "pnpm@11.28.5"
}
